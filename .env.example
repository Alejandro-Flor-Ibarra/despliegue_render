# Configuración local
DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-local

# PostgreSQL opcional: quita el # y completa los datos si vas a usar PostgreSQL.
# Si lo dejas comentado, el proyecto sigue usando SQLite por defecto.
# DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/nombre_base

# MongoDB local: usa una sola de estas opciones y completa sus datos.
# MONGODB_URI=mongodb://localhost:27017/nombre_base

# MongoDB Atlas: alternativa a la URI local. No pongas aquí credenciales reales.
# MONGODB_URI=mongodb+srv://usuario:contrasena@cluster.example.mongodb.net/nombre_base